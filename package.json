{
  "name": "@disphere/code-quality-config",
  "version": "0.2.0",
  "description": "Provides opinionated configuration for npm plugins that deal with code quality.",
  "license": "0BSD",
  "author": "disphere interactive GmbH",
  "type": "module",
  "exports": {
    "./eslint": "./eslint.js",
    "./prettier": "./prettier.js"
  },
  "files": [
    "eslint.js",
    "prettier.js",
    "lint-report.mjs",
    "which-modules.mjs"
  ],
  "bin": {
    "lint-report": "./lint-report.mjs",
    "which-modules": "./which-modules.mjs"
  },
  "keywords": [
    "code-quality",
    "eslint",
    "prettier"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volldigital/npm-code-quality-config.git"
  },
  "homepage": "https://github.com/volldigital/npm-code-quality-config#readme",
  "bugs": {
    "url": "https://github.com/volldigital/npm-code-quality-config/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "lint:report": "eslint --format json | node ./lint-report.mjs",
    "lint:which-modules": "eslint --format json | node ./which-modules.mjs",
    "test": "node ./scripts/smoke-test.mjs"
  },
  "peerDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": ">=5.1.6 <6.1.0"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.18.3",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-cypress": "^7.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-mocha": "^12.0.2",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-sql": "^0.20.0",
    "typescript-eslint": "^8.66.0"
  }
}
